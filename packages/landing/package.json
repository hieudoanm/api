    "daisyui": "5.8.3",
    "fflate": "0.8.3",
    "marked": "18.3.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "5.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@tailwindcss/turbopack": "4.3.5",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.11",
    "@types/react": "19.3.2",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.2",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.1",
    "kill-port": "2.0.1",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "rimraf": "6.1.4",
